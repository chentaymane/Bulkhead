# Machine-specific state written by Bulkhead.ps1 -Harden -Apply.
# Contains your previous registry values and hostname. Local only.
revert-state.json

# ---------------------------------------------------------------------------
# REAL WireGuard configs contain your PRIVATE KEY. Never commit them.
# The annotated template has placeholders only and IS tracked.
# ---------------------------------------------------------------------------
network/*.conf
!network/wireguard-template.conf

# Same for any provider config you drop in
*.wgconf
*privatekey*
*.key

# Browser profile data (lives in %LOCALAPPDATA%, but just in case)
brave-lane2/
lane*-profile/
*.sqlite
*.log
