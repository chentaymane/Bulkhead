# Normalize line endings so commits stop emitting CRLF warnings and diffs
# stay clean across machines.

# Default: detect text, store LF in the repo.
* text=auto

# Windows-native script types must keep CRLF in the working tree.
# cmd.exe in particular can misparse LF-only batch files.
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.psd1  text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

# Everything else stays LF.
*.md    text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.conf  text eol=lf
*.yml   text eol=lf

# Never touch these.
*.png   binary
*.jpg   binary
*.ico   binary
*.pdf   binary
